{
  "schema_version": "1.0.0",
  "dataset": {
    "name": "AliCCP",
    "full_name": "Alibaba Click and Conversion Prediction",
    "row_meaning": "合并后的一行表示一次商品曝光（不是一个用户）。同一用户可以对应多行曝光。",
    "language_note": "所有特征值均已匿名化。编号能说明字段类型，但不能还原真实用户名、商品名、店铺名或品牌名。"
  },
  "raw_files": {
    "sample_skeleton_train.csv": {
      "role": "训练集曝光主表",
      "columns": ["sample_id", "click", "conversion", "common_id", "declared_feature_count", "skeleton_features"]
    },
    "common_features_train.csv": {
      "role": "训练集公共用户特征表",
      "columns": ["common_id", "declared_feature_count", "common_features"]
    },
    "join": {
      "left": "sample_skeleton_train.csv.common_id",
      "right": "common_features_train.csv.common_id",
      "relationship": "many-to-one",
      "explanation": "多条曝光记录可以引用同一组公共特征。"
    },
    "feature_encoding": {
      "between_features": "\\x01",
      "between_field_and_value": "\\x02",
      "between_value_and_weight": "\\x03",
      "logical_form": "field_id\\x02feature_value\\x03weight"
    }
  },
  "labels": {
    "click": {
      "chinese_name": "点击标签",
      "values": {"0": "未点击", "1": "点击"},
      "prediction": "P(click | impression)",
      "metric": "CTR AUC",
      "evaluation_scope": "全部曝光记录"
    },
    "conversion": {
      "chinese_name": "转化/购买标签",
      "values": {"0": "未转化", "1": "转化"},
      "prediction": "P(conversion | click)",
      "metric": "CVR AUC",
      "evaluation_scope": "仅 click=1 的记录",
      "invalid_combination": "click=0 且 conversion=1"
    }
  },
  "identifiers": {
    "sample_id": {
      "chinese_name": "曝光样本ID",
      "meaning": "标识一次曝光记录，不作为业务特征训练。"
    },
    "common_id": {
      "chinese_name": "公共特征关联ID",
      "meaning": "用于连接 skeleton 与 common_features，不等于真正的用户ID。"
    }
  },
  "features": {
    "101": {
      "name": "user_id",
      "chinese_name": "用户ID",
      "group": "user",
      "type": "categorical",
      "cardinality": "high",
      "usually_from": "common_features",
      "meaning": "匿名用户编号，可用于用户级切分和用户Embedding。"
    },
    "109_14": {
      "name": "user_categories",
      "chinese_name": "用户历史类目行为",
      "group": "user_history",
      "type": "multi_categorical_weighted",
      "cardinality": "high",
      "usually_from": "common_features",
      "meaning": "用户历史行为涉及的商品类目ID及对应计数/权重。"
    },
    "110_14": {
      "name": "user_shops",
      "chinese_name": "用户历史店铺行为",
      "group": "user_history",
      "type": "multi_categorical_weighted",
      "cardinality": "high",
      "usually_from": "common_features",
      "meaning": "用户历史行为涉及的店铺ID及对应计数/权重。"
    },
    "121": {
      "name": "user_profile",
      "chinese_name": "用户画像类别",
      "group": "user",
      "type": "categorical",
      "cardinality": "unknown",
      "usually_from": "common_features",
      "meaning": "匿名化的用户画像类别ID；公开定义没有提供每个取值的自然语言标签。"
    },
    "122": {
      "name": "user_group",
      "chinese_name": "用户画像分组",
      "group": "user",
      "type": "categorical",
      "cardinality": "unknown",
      "usually_from": "common_features",
      "meaning": "匿名化的用户画像分组ID。"
    },
    "124": {
      "name": "user_gender",
      "chinese_name": "用户性别类别",
      "group": "user",
      "type": "categorical",
      "cardinality": "low",
      "usually_from": "common_features",
      "meaning": "匿名化的性别类别ID；不能可靠地把具体数值解释为男或女。"
    },
    "125": {
      "name": "user_age",
      "chinese_name": "用户年龄分组",
      "group": "user",
      "type": "categorical",
      "cardinality": "low",
      "usually_from": "common_features",
      "meaning": "匿名化的年龄段ID，不是实际年龄数值。"
    },
    "126": {
      "name": "user_consumption_1",
      "chinese_name": "用户消费水平类型一",
      "group": "user",
      "type": "categorical",
      "cardinality": "low",
      "usually_from": "common_features",
      "meaning": "第一种口径的匿名消费能力/消费等级。"
    },
    "127": {
      "name": "user_consumption_2",
      "chinese_name": "用户消费水平类型二",
      "group": "user",
      "type": "categorical",
      "cardinality": "low",
      "usually_from": "common_features",
      "meaning": "第二种口径的匿名消费能力/消费等级。"
    },
    "127_14": {
      "name": "user_brands",
      "chinese_name": "用户历史品牌行为",
      "group": "user_history",
      "type": "multi_categorical_weighted",
      "cardinality": "high",
      "usually_from": "common_features",
      "meaning": "用户历史行为涉及的品牌ID及对应计数/权重。"
    },
    "128": {
      "name": "user_is_occupied",
      "chinese_name": "用户职业/是否工作类别",
      "group": "user",
      "type": "categorical",
      "cardinality": "low",
      "usually_from": "common_features",
      "meaning": "与用户是否就业或职业状态相关的匿名类别ID。"
    },
    "129": {
      "name": "user_geography",
      "chinese_name": "用户地域信息",
      "group": "user",
      "type": "categorical",
      "cardinality": "unknown",
      "usually_from": "common_features",
      "meaning": "匿名化的用户地域类别ID。"
    },
    "150_14": {
      "name": "user_intentions",
      "chinese_name": "用户历史意图行为",
      "group": "user_history",
      "type": "multi_categorical_weighted",
      "cardinality": "high",
      "usually_from": "common_features",
      "meaning": "用户历史行为涉及的兴趣/意图节点ID及对应计数/权重。"
    },
    "205": {
      "name": "item_id",
      "chinese_name": "商品ID",
      "group": "item",
      "type": "categorical",
      "cardinality": "high",
      "usually_from": "sample_skeleton",
      "meaning": "当前曝光商品的匿名编号。"
    },
    "206": {
      "name": "item_category",
      "chinese_name": "商品类目ID",
      "group": "item",
      "type": "categorical",
      "cardinality": "high",
      "usually_from": "sample_skeleton",
      "meaning": "当前商品所属类目的匿名编号。"
    },
    "207": {
      "name": "item_shop",
      "chinese_name": "店铺ID",
      "group": "item",
      "type": "categorical",
      "cardinality": "high",
      "usually_from": "sample_skeleton",
      "meaning": "当前商品所属店铺的匿名编号。"
    },
    "210": {
      "name": "item_intention",
      "chinese_name": "商品意图/兴趣节点ID",
      "group": "item",
      "type": "multi_categorical_weighted",
      "cardinality": "high",
      "usually_from": "sample_skeleton",
      "meaning": "当前商品所属的一个或多个兴趣/购买意图节点。原始行中可能重复出现210。"
    },
    "216": {
      "name": "item_brand",
      "chinese_name": "品牌ID",
      "group": "item",
      "type": "categorical",
      "cardinality": "high",
      "usually_from": "sample_skeleton",
      "meaning": "当前商品所属品牌的匿名编号。"
    },
    "301": {
      "name": "position",
      "chinese_name": "展示位置ID",
      "group": "context",
      "type": "categorical",
      "cardinality": "unknown",
      "usually_from": "sample_skeleton",
      "meaning": "商品在推荐页面或展示场景中的匿名位置类别。"
    },
    "508": {
      "name": "user_item_categories",
      "chinese_name": "用户历史类目与当前商品类目的交叉特征",
      "group": "user_item_cross",
      "type": "categorical_weighted",
      "cardinality": "high",
      "usually_from": "sample_skeleton",
      "meaning": "由用户历史类目109_14和当前商品类目206组合形成。"
    },
    "509": {
      "name": "user_item_shops",
      "chinese_name": "用户历史店铺与当前店铺的交叉特征",
      "group": "user_item_cross",
      "type": "categorical_weighted",
      "cardinality": "high",
      "usually_from": "sample_skeleton",
      "meaning": "由用户历史店铺110_14和当前店铺207组合形成。"
    },
    "702": {
      "name": "user_item_brands",
      "chinese_name": "用户历史品牌与当前品牌的交叉特征",
      "group": "user_item_cross",
      "type": "categorical_weighted",
      "cardinality": "high",
      "usually_from": "sample_skeleton",
      "meaning": "由用户历史品牌127_14和当前品牌216组合形成。"
    },
    "853": {
      "name": "user_item_intentions",
      "chinese_name": "用户历史意图与当前商品意图的交叉特征",
      "group": "user_item_cross",
      "type": "categorical_weighted",
      "cardinality": "high",
      "usually_from": "sample_skeleton",
      "meaning": "由用户历史意图150_14和当前商品意图210组合形成。"
    }
  },
  "derived_columns": {
    "D<field_id>": {
      "meaning": "本项目预处理器根据原始第三段weight生成的数值列；同一field重复时将weight求和。它不是AliCCP额外的官方字段编号。"
    },
    "ctcvr": {
      "meaning": "可派生为 click * conversion，表示曝光后最终转化；不是原始特征，不能作为输入泄漏给模型。"
    }
  },
  "agent_guidance": {
    "do_not_train_on": ["sample_id", "common_id", "click", "conversion", "ctcvr"],
    "_note": "这是答案",
    "user_id_field": "101",
    "item_id_field": "205",
    "multi_value_fields": ["109_14", "110_14", "127_14", "150_14", "210"],
    "required_metrics": {
      "ctr_auc": "全部曝光上的 click AUC",
      "cvr_auc": "click=1 子集上的 conversion AUC",
      "cvr_auc_all": "全部曝光上的 conversion AUC（官方口径确认前同时保留）"
    },
    "warnings": [
      "匿名特征值不能还原成自然语言类别。",
      "common_id只是连接键，不应被解释为user_id。",
      "多值字段若只保留最后一个值会损失信息；正式模型应使用序列/集合编码或明确的聚合策略。",
      "click=0且conversion=1违反曝光-点击-转化漏斗，应报告并按官方预处理规则处理。"
    ]
  },
  "sources": [
    {
      "name": "NVIDIA Merlin AliCCP dataset definition",
      "url": "https://github.com/NVIDIA-Merlin/models/blob/main/merlin/datasets/ecommerce/aliccp/dataset.py",
      "supports": "23个字段的英文名称、分组及用户-商品交叉关系"
    },
    {
      "name": "torch-rechub AliCCP preprocessing",
      "url": "https://github.com/datawhalechina/torch-rechub/blob/main/examples/ranking/data/ali-ccp/preprocess_ali_ccp.py",
      "supports": "23个字段编号集合及公开预处理方式"
    },
    {
      "name": "AITM public AliCCP preprocessing",
      "url": "https://github.com/xidongbo/AITM/blob/main/process_public_dataset.py",
      "supports": "常用18个类别字段子集、标签与表连接实现"
    },
    {
      "name": "AliCCP Tianchi dataset page",
      "url": "https://tianchi.aliyun.com/dataset/408",
      "supports": "数据集来源页面"
    }
  ]
}
