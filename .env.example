# 本地专用 —— 复制成 .env 再填。.env / .env.* 已被 .gitignore 挡住，绝不会进仓库。
#
#   cp .env.example .env      # macOS / Linux
#   copy .env.example .env    # Windows

# 用 DeepSeek 而不是 Anthropic（不设这一行会走 Anthropic，需要 ANTHROPIC_API_KEY）
AGENT_PROVIDER=deepseek

# 你的 DeepSeek 密钥。只从环境变量读，agent 不会把它写进任何文件或日志。
DEEPSEEK_API_KEY=sk-你的密钥

# 型号。不设默认是 deepseek-v4-flash；正式跑用 pro。
AGENT_DEEPSEEK_MODEL=deepseek-v4-pro
