# ── 数据：绝对不要提交，原始数据几十 GB ──
data/
*.csv
*.parquet
*.npy
*.npz
*.feather
*.h5

# ── 模型与产物 ──
checkpoints/
*.pt
*.pth
*.ckpt
submissions/

# ── 运行产物（日志目录保留结构，内容不提交）──
# 开发期间的日志是噪音，而且演习跑的是假数据，进仓库只会误导人。
logs/*
!logs/.gitkeep
runs/
experiments.db
*.jsonl

# ── 但交付物必须进仓库（交付物 #3 明确要求提交逐轮日志）──
# 最终那一场跑完：agent.cli finalize
# 只放行 deliverables/，logs/ 依然挡着，别把演习数据也带进去。
# （注意跟上面第 15 行的 submissions/ 区分开：那个装模型产物，是忽略的）
!deliverables/
!deliverables/**

# ── 演习产出的假零件（agent.cli run --offline）──
# 假工兵写的文件会落进 modules/，跟真零件混在一起。
# 真溜进去过一次（demo_op.py），交付前才发现。
modules/**/_offline_*.py

# ── Python ──
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/

# ── 密钥：API key 绝对不要提交 ──
.env
.env.*
*.key
secrets.*

# ── 系统 ──
.DS_Store
.idea/
.vscode/
docs/DEVPOST*
docs/devpost_*
